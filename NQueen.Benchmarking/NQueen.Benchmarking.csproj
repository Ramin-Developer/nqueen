<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>14.0</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Deterministic>true</Deterministic>
		<Platforms>AnyCPU;x64</Platforms>
		<!-- Disable the VS-only assembly-level BDN config injected by the
			 DiagnosticsHub package so the benchmarks run correctly from the
			 command line (dotnet run -c Release). The package's own generated
			 file documents this symbol as the recommended opt-out. -->
		<DefineConstants>$(DefineConstants);DISABLE_PROFILER_AGENT_CONFIG</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" />
		<PackageReference Include="Microsoft.VisualStudio.DiagnosticsHub.BenchmarkDotNetDiagnosers" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NQueen.Domain\NQueen.Domain.csproj" />
		<ProjectReference Include="..\NQueen.Kernel\NQueen.Kernel.csproj" />
	</ItemGroup>

	<!-- The DiagnosticsHub package injects a netstandard2.0 System.Collections.Immutable
		 reference that conflicts with the newer shared-framework copy (yellow triangle).
		 The framework already provides it, so drop the package's hard reference. -->
	<Target Name="RemoveDiagnosticsHubImmutableReference" BeforeTargets="ResolveAssemblyReferences">
		<ItemGroup>
			<Reference Remove="System.Collections.Immutable" />
		</ItemGroup>
	</Target>

</Project>
